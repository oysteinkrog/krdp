<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
      http://www.kde.org/standards/kcfg/1.0/kcfg.xsd" >
  <kcfgfile name="krdpserverrc"/>
  <group name="General">
    <entry name="listenPort" key="ListenPort" type="Int">
      <label>The port the server listens on</label>
      <default>3389</default>
    </entry>
      <entry name="autogenerateCertificates" key="AutogenerateCertificates" type="Bool">
      <label>Are certificates autogenerated during server start</label>
      <default>true</default>
    </entry>
    <entry name="certificate" key="Certificate" type="String">
      <label>The certificate to use for TLS connections</label>
    </entry>
    <entry name="certificateKey" key="CertificateKey" type="String">
      <label>The key that matches the TLS certificate</label>
    </entry>
    <entry name="quality" key="Quality" type="Int">
      <label>The quality of the video stream. The maximum quality when AdaptiveQuality is enabled.</label>
      <default>75</default>
    </entry>
    <entry name="adaptiveQuality" key="AdaptiveQuality" type="Bool">
      <label>Adjust the video quality at runtime based on the client's network conditions, up to Quality.</label>
      <default>true</default>
    </entry>
    <entry name="videoCodec" key="VideoCodec" type="String">
      <label>Video codec: KPipeWire (H.264 4:2:0 from KPipeWire), Auto (AVC444 if the client supports it, else AVC420, else RemoteFX), AVC444, AVC420 or RemoteFX</label>
      <default>KPipeWire</default>
    </entry>
    <entry name="videoEncoder" key="VideoEncoder" type="String">
      <label>H.264 encoder for the AVC444 and AVC420 codecs: Auto (NVENC, else libx264), NVENC or libx264</label>
      <default>Auto</default>
    </entry>
    <entry name="encoderSpeed" key="EncoderSpeed" type="String">
      <label>H.264 encoder speed preset for the AVC444 and AVC420 codecs: Default, Fast or Fastest</label>
      <default>Fast</default>
    </entry>
    <entry name="remoteFxQuality" key="RemoteFXQuality" type="Int">
      <label>RemoteFX quality from 0 to 100. 100 keeps every detail, 50 is the Windows default.</label>
      <default>100</default>
      <min>0</min>
      <max>100</max>
    </entry>
    <entry name="audioCodec" key="AudioCodec" type="String">
      <label>Audio codec: PCM (uncompressed 48 kHz, lossless, no encoder delay, about 1.5 Mbit/s), Auto (AAC, else Opus, else PCM), AAC or Opus</label>
      <default>PCM</default>
    </entry>
    <entry name="audioIdleTimeout" key="AudioIdleTimeout" type="Int">
      <label>Seconds of silence before the client's audio stream is closed; it reopens when sound returns. 0 keeps it open.</label>
      <default>60</default>
      <min>0</min>
    </entry>
    <entry name="Users" type="StringList">
      <label>Users allowed to login, passwords are stored in KWallet</label>
    </entry>
    <entry name="systemUserEnabled" key="SystemUserEnabled" type="Bool">
      <label>Whether the current user can log in via PAM</label>
      <default>false</default>
    </entry>
    <entry name="autostart" key="Autostart" type="Bool">
      <label>Autostart the server on login</label>
      <default>false</default>
    </entry>
    <entry name="exclusiveMode" key="ExclusiveMode" type="Bool">
      <label>Disable the host monitors and create virtual screens for exclusive session use by a remote user</label>
      <default>false</default>
    </entry>
  </group>
</kcfg>
